{
  "name": "repo-report-card",
  "description": "Hackathon judging pipeline: JSON dossier builder + HTML scorecard renderer, scored by Claude as Principal Skinner",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/slmingol/repo-report-card.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "principal-skinner": "./out/cli.js",
    "skinner": "./out/cli.js",
    "skinner-render": "./out/render.js"
  },
  "files": [
    "out/**/*.js",
    "imgs/cropped/*.png",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0"
  }
}
